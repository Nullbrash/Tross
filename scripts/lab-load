#!/usr/bin/env bash
# Нагрузочные сценарии на закрытом стенде: синтетические аналоги торрента,
# Steam, стрима и игры — по отдельности и вместе; без демона (простой маршрут
# через isp1) и с демоном. Запуск на стенде от обычного пользователя (sudo без
# пароля); стенд поднимается с нуля и в конце снимается.
#
#   scripts/lab-load [секунд на сценарий=60] [bare|daemon|classes|cake|both=both] [сценарии...]
#
# cake — классы и очереди CAKE на всех каналах (scripts/lab-cake-config;
# SQM_START/SQM_AUTO — фиксированный процент); перед сценариями — тест
# скорости isp1, как ночью; в конце сценария — скорости очередей. Сценарий
# broadcast — свой эфир (8 Мбит/с отдачи) во время полной отдачи торрента.
# LOAD_RATES="isp1 isp2" — скорости каналов, Мбит/с в обе стороны (по
# умолчанию "500 300").
#
# classes — демон с классами Этапа 2 (configs/lab-classes.yaml): игра —
# класс gaming, торрент (TCP 88) — bulk, прочее — default; доменные
# множества перед сценариями наполняются SET_FILL адресами каждое (по
# умолчанию 2000) — как наполнит их резолвер; цена — в classes-sets.txt.
# Режимы можно перечислить: "daemon classes".
#
# Сценарии: idle game torrent steam stream all torrent-user torrent-max
# all-user (= torrent-user + steam + stream). Во всех, кроме idle, идёт
# «игра» (UDP 64 пакета/с) — её задержка под нагрузкой и есть прирост пинга.
# Канал isp1 ограничен 500/500 Мбит/с (порядок реального канала 60 МБ/с),
# offload off — пакеты настоящего размера (честный ЦП, см. CONTEXT_lab).
#
# Результаты: ~/lab-results/<дата>-load/<режим>-<сценарий>/ — system.csv,
# net.csv, summary.txt (labmeasure), load-*.txt (генераторы), game.txt,
# conntrack.txt; daemon-api/ — ответы API демона после прогона.
set -euo pipefail

cd "$(dirname "$0")/.."
# Один прогон на стенде за раз: два прогона поднимали и снимали бы один и тот
# же стенд. Блокировка держится до выхода процесса.
exec 9>>/run/lock/tross-lab.lock
flock -n 9 || { echo "lab-load: stand is busy — another run holds /run/lock/tross-lab.lock" >&2; exit 3; }
export PATH=$HOME/sdk/go/bin:$PATH
dur=${1:-60}
modes=${2:-both}
shift 2 || shift $#
scenarios=("$@")
[ ${#scenarios[@]} -gt 0 ] || scenarios=(idle game torrent steam stream all)
[ "$modes" = both ] && modes="bare daemon"

out=$HOME/lab-results/$(date +%F)-load
lab=$PWD/scripts/lab-netns
bin=$PWD/bin
srv=http://203.0.113.10
api=http://192.168.77.1:8080

declare -A LOAD=(
	[torrent]="-down 150 -up 50 -chunk 1000000 -churn"
	[steam]="-down 8 -chunk 100000000"
	[stream]="-down 1 -down-mbit 20 -up 1 -up-mbit 8 -chunk 5000000000"
	# Свой эфир 1080p: только отдача 8 Мбит/с (с классами — класс broadcast).
	[broadcast-up]="-up 1 -up-mbit 8 -chunk 5000000000"
	# Домашний торрент-клиент с ограничением скорости: одна загрузка до 400
	# пиров, до 80 слотов отдачи, ~2/0,5 МБ/с на всё, uTP и DHT — фон UDP;
	# пиры — 64 адреса.
	[torrent-user]="-down 400 -down-mbit 0.042 -up 80 -up-mbit 0.0525 -chunk 1000000000 -targets 203.0.113.64/26 -udp-pps 200 -port 88"
	# То же без лимитов скорости (если их поднять под быстрый канал).
	[torrent-max]="-down 400 -up 80 -chunk 5000000 -targets 203.0.113.64/26 -udp-pps 200 -port 88"
)

S() { sudo -n "$@"; }
client() { S ip netns exec tl-client "$@"; }
snap() { S sh -c '{ ip -4 route show table all; ip rule; ip -br link; nft list ruleset; } | md5sum'; }

go build -trimpath -o bin/ ./cmd/...
mkdir -p "$out"
before=$(snap)

cleanup() {
	S pkill -INT -x trossd 2>/dev/null || true
	sleep 1
	S "$lab" down >/dev/null 2>&1 || true
}
trap cleanup EXIT

S "$lab" down >/dev/null 2>&1 || true
S "$lab" up >/dev/null
S "$lab" offload off >/dev/null
# Скорости каналов: isp1 — как прежде 500/500; isp2 — тоже с ограничением:
# с классами загрузки делятся между каналами, а настоящий второй провайдер
# гигабиты не даст (без ограничения торрент уходил в isp2 на 1,5 Гбит/с).
read -r r1 r2 <<<"${LOAD_RATES:-500 300}"
S "$lab" shape isp1 8 1 0 "$r1" "$r1" >/dev/null
S "$lab" shape isp2 12 2 0 "$r2" "$r2" >/dev/null

# fill_sets N — в каждое доменное множество (наполнит резолвер, этап 4) по N
# адресов из 100.100.0.0/14 (на стенде не встречаются): время загрузки и
# сколько памяти ядра это заняло.
fill_sets() {
	local n=$1 f=$out/classes-fill.nft sets i=0 m0 m1 t0 t1
	sets=$(S ip netns exec tl-tross nft list sets inet tross | awk '$1 == "set" && $2 ~ /^tross_(dp|du|lm|la)_/ {print $2}')
	: >"$f"
	for s in $sets; do
		awk -v s="$s" -v n="$n" -v base=$((i * n)) 'BEGIN {
			line = ""
			for (j = 0; j < n; j++) {
				k = base + j
				line = line (line == "" ? "" : ", ") sprintf("100.%d.%d.%d timeout 1h", 100 + int(k / 65536), int(k / 256) % 256, k % 256)
				if ((j + 1) % 1000 == 0 || j == n - 1) { print "add element inet tross " s " { " line " }"; line = "" }
			}
		}' >>"$f"
		i=$((i + 1))
	done
	sync; S sh -c 'echo 3 > /proc/sys/vm/drop_caches'
	m0=$(awk '/^MemAvailable/ {print $2}' /proc/meminfo)
	t0=$(date +%s%N)
	S ip netns exec tl-tross nft -f "$f"
	t1=$(date +%s%N)
	sleep 2
	m1=$(awk '/^MemAvailable/ {print $2}' /proc/meminfo)
	echo "domain sets: $i x $n addresses = $((i * n)); nft load $(((t1 - t0) / 1000000)) ms; MemAvailable $m0 -> $m1 kB (-$((m0 - m1)) kB)" | tee "$out/classes-sets.txt"
}

run_scenario() {
	local mode=$1 sc=$2 dir=$out/$1-$2 pids=()
	rm -rf "$dir"
	mkdir -p "$dir"
	echo "--- $mode/$sc (${dur}s)"
	(for _ in $(seq 1 $((dur / 2))); do S ip netns exec tl-tross cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0; sleep 2; done) >"$dir/conntrack.txt" &
	pids+=($!)
	S "$bin/labmeasure" -out "$dir" -duration "${dur}s" -proc trossd -netns tl-tross >/dev/null &
	pids+=($!)
	local loads=()
	case $sc in
	idle | game) ;;
	all) loads=(torrent steam stream) ;;
	all-user) loads=(torrent-user steam stream) ;;
	# Эфир во время полной отдачи торрента (вопрос 5 плана Этапа 3).
	broadcast) loads=(torrent-max broadcast-up) ;;
	*) loads=("$sc") ;;
	esac
	for k in "${loads[@]}"; do
		local url=$srv
		# С классами торрент — на TCP 88 «пиров», эфир — на 203.0.113.100:89:
		# их правила в lab-classes.yaml.
		if [ "$mode" != bare ] && [ "$mode" != daemon ] && [ "$k" = torrent ]; then url=$srv:88; fi
		if [ "$k" = broadcast-up ]; then url=http://203.0.113.100:89; fi
		# shellcheck disable=SC2086
		client "$bin/labsrv" load -url "$url" ${LOAD[$k]} -duration "${dur}s" >"$dir/load-$k.txt" 2>&1 &
		pids+=($!)
	done
	if [ "$sc" != idle ]; then
		# Старт через 3 с — после разгона нагрузки; конец — до её остановки.
		(sleep 3; client "$bin/labsrv" udpping -target 203.0.113.10:9000 -rate 64 -n $(((dur - 6) * 64)) -size 120) >"$dir/game.txt" 2>&1 &
		pids+=($!)
	fi
	wait "${pids[@]}" || true
	for f in "$dir"/load-*.txt "$dir/game.txt"; do [ -f "$f" ] && echo "    $(basename "$f"): $(tail -1 "$f")"; done
	grep -E '^(cpu|mem|proc|disk|temp|net tl-tross/wan1 )' "$dir/summary.txt" | sed 's/^/    /' || true
	echo "    conntrack max: $(sort -n "$dir/conntrack.txt" | tail -1)"
	if [ "$mode" = cake ]; then
		S ip netns exec tl-tross wget -qO- "$api/api/links" >"$dir/links.json" || true
		python3 -c 'import json,sys
for l in json.load(open(sys.argv[1]))["links"]:
    q = l.get("sqm")
    if q: print("    sqm %s: down %.0f Mbit/s (%s, %.1f %%), up %.0f Mbit/s (%s, %.1f %%)" % (l["id"], q["down"]["rate_bps"]/1e6, q["down"].get("basis", "-"), q["down"]["pct"], q["up"]["rate_bps"]/1e6, q["up"].get("basis", "-"), q["up"]["pct"]))' "$dir/links.json" || true
	fi
}

for mode in $modes; do
	case $mode in
	bare)
		S "$lab" simple-route isp1 >/dev/null
		;;
	daemon | classes | cake)
		S "$lab" simple-route off >/dev/null
		S rm -rf "$out/data"
		cfg=configs/lab.yaml
		if [ "$mode" = classes ]; then cfg=configs/lab-classes.yaml; fi
		if [ "$mode" = cake ]; then
			cfg=$out/lab-cake.yaml
			scripts/lab-cake-config >"$cfg"
		fi
		S ip netns exec tl-tross "$bin/trossd" -config "$cfg" -data-dir "$out/data" >"$out/trossd-$mode.log" 2>&1 &
		for _ in $(seq 1 60); do
			S ip netns exec tl-tross wget -qO- "$api/api/links" 2>/dev/null | grep -q '"id":"isp1"[^}]*"state":"up"' && break
			sleep 1
		done
		S ip netns exec tl-tross wget -qO- "$api/api/links" | grep -q '"id":"isp1"[^}]*"state":"up"' || { echo "daemon did not bring isp1 up"; exit 1; }
		if [ "$mode" = classes ]; then fill_sets "${SET_FILL:-2000}"; fi
		if [ "$mode" = cake ]; then
			# Как ночной тест: база загрузки isp1 — из замера (отдача —
			# пассивно, по насыщению в первых сценариях).
			S ip netns exec tl-tross wget -qO- --post-data= "$api/api/links/isp1/speedtest" >"$out/cake-speedtest.json" || true
			echo "    speed test isp1: $(cat "$out/cake-speedtest.json")"
		fi
		;;
	*) echo "unknown mode $mode"; exit 2 ;;
	esac
	for sc in "${scenarios[@]}"; do run_scenario "$mode" "$sc"; done
	if [ "$mode" != bare ]; then
		mkdir -p "$out/daemon-api"
		for p in metrics events "system/stats?res=minute" "links/isp1/stats?res=minute" "logs?level=warn"; do
			S ip netns exec tl-tross wget -qO- "$api/api/$p" >"$out/daemon-api/$mode-$(echo "$p" | tr '/?=&' '____').json" || true
		done
		S pkill -INT -x trossd || true
		sleep 2
		S ls -l "$out/data" >"$out/daemon-api/$mode-data-dir.txt"
	fi
done

cleanup
trap - EXIT
after=$(snap)
if [ "$before" != "$after" ]; then
	echo "HOST NETWORK CHANGED: $before -> $after"
	exit 1
fi
echo "LOAD DONE: $out"
