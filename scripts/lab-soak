#!/usr/bin/env bash
# Длинный прогон демона на закрытом стенде: «домашний день» по кругу —
# простой, игра, торрент, Steam, стрим — до истечения срока. Цель: реальная
# запись на SSD в сутки, рост базы, память демона во времени, сводки по часам.
# Не зависит ни от внешней сети, ни от SSH: запускать службой systemd, чтобы
# пережил отключение. Бинарники собрать заранее (scripts/lab-sync build).
#
#   sudo systemd-run --unit=tross-soak --uid=tross --setenv=HOME=/home/tross \
#     --working-directory=/home/tross/tross scripts/lab-soak 8h
#   journalctl -u tross-soak -f          # ход прогона
#   SOAK_UNIT=3 scripts/lab-soak 4m       # быстрая проверка самого скрипта
#   SOAK_CONFIG=configs/lab-classes.yaml  # с классами Этапа 2 (--setenv=…)
#   SOAK_CONFIG=cake                      # классы + очереди CAKE (scripts/lab-cake-config)
#   SOAK_PROVIDER=1   «сутки провайдера»: скорость проводных каналов по кругу
#                     каждые 10 «минут», у LTE — случайная каждые 5
#   SOAK_CHAOS=1      хаос каналов: обрыв случайного канала (иногда обоих
#                     проводных) на 20–90 с каждые 3–8 «минут»
#   SOAK_RESTARTS=N   хаос перезапусков: каждые N «минут» — мягкая остановка
#                     или kill -9 с trossd -cleanup (как служба), запуск заново
#   SOAK_DNS=1        резолвер «hash» стенда (свой адрес на имя) и DNS-нагрузка
#                     50 запросов/с по кругу: промахи, наполнение множеств,
#                     кэш (labsrv dnsload) → dns.txt
#   SOAK_LIFE=1       «жизнь дома»: 4 устройства каждые 2 с открывают новые
#                     соединения разных классов (labsrv life) → life.jsonl:
#                     куда ушло каждое (по адресу у сервера и по conntrack)
#   SOAK_HOME=1       «живой дом»: раздача адресов (dnsmasq), реестр,
#                     UPnP; устройства приходят по DHCP и уходят, иногда меняют
#                     MAC; пробросы NAT-PMP/UPnP открываются, продлеваются,
#                     истекают; две «вкладки» интерфейса держат поток событий,
#                     «браузер» опрашивает API → home.txt, ws.txt
#   sudo systemctl stop tross-soak       # досрочно (стенд снимется)
#
# Результаты: ~/lab-results/<дата>-soak/ — metrics.jsonl (каждые 5 мин),
# segments.txt (сегменты и пинг игры), measure/ (labmeasure раз в 10 с),
# api-*.json (сводки в конце), trossd.log, data/ (база).
set -euo pipefail

cd "$(dirname "$0")/.."
# Один прогон на стенде за раз: два прогона поднимали и снимали бы один и тот
# же стенд. Блокировка держится до выхода процесса; фоновым циклам её
# дескриптор не передаётся (9>&-) — иначе их недоспанный sleep держал бы
# стенд занятым минуты после конца прогона.
exec 9>>/run/lock/tross-lab.lock
flock -n 9 || { echo "lab-soak: stand is busy — another run holds /run/lock/tross-lab.lock" >&2; exit 3; }
total=${1:-8h}
case $total in
*h) secs=$((${total%h} * 3600)) ;;
*m) secs=$((${total%m} * 60)) ;;
*) secs=$total ;;
esac
deadline=$(($(date +%s) + secs))
# SOAK_UNIT — секунд в «минуте» сегмента: для быстрой проверки скрипта.
unit=${SOAK_UNIT:-60}
out=$HOME/lab-results/$(date +%F)-soak
lab=$PWD/scripts/lab-netns
bin=$PWD/bin
srv=http://203.0.113.10
api=https://192.168.77.1:8080
# Вход в API: свой пароль на прогон (trossd passwd), сессия — в cookie.
pw="soak-$(date +%s)-$RANDOM"
[ -x "$bin/trossd" ] && [ -x "$bin/labsrv" ] && [ -x "$bin/labmeasure" ] || { echo "build first: scripts/lab-sync build"; exit 1; }

# Сегменты «дня»: имя, минуты, нагрузка labsrv load (пусто — без нагрузки).
SEGMENTS=(
	"idle 15 -"
	"game 10 -"
	"torrent-user 20 -down 400 -down-mbit 0.042 -up 80 -up-mbit 0.0525 -chunk 1000000000 -targets 203.0.113.64/26 -udp-pps 200 -port 88"
	"steam 5 -down 8 -chunk 100000000"
	"stream 10 -down 1 -down-mbit 20 -up 1 -up-mbit 8 -chunk 5000000000"
)

S() { sudo -n "$@"; }
client() { S ip netns exec tl-client "$@"; }
tross() { S ip netns exec tl-tross "$@"; }
snap() { S sh -c '{ ip -4 route show table all; ip rule; ip -br link; nft list ruleset; } | md5sum'; }
# login — новая сессия (токен CSRF — в $out/csrf); apiget/apisend — с ней.
login() {
	tross wget --no-check-certificate --save-cookies "$out/cookies" --keep-session-cookies \
		--header='Content-Type: application/json' --post-data="{\"password\":\"$pw\"}" \
		-qO- "$api/api/auth/login" 2>/dev/null | sed -n 's/.*"csrf":"\([^"]*\)".*/\1/p' >"$out/csrf.tmp" &&
		[ -s "$out/csrf.tmp" ] && mv "$out/csrf.tmp" "$out/csrf"
}
apiget() { tross wget --no-check-certificate --load-cookies "$out/cookies" -qO- "$api/api/$1" 2>/dev/null; }
apisend() {
	tross wget --no-check-certificate --load-cookies "$out/cookies" --method="$1" \
		--header="X-CSRF-Token: $(cat "$out/csrf" 2>/dev/null)" --header='Content-Type: application/json' \
		--body-data="${3:-}" -qO- "$api/api/$2" 2>/dev/null
}
now() { date +%s; }
log() { echo "$(date +%T) $*" | tee -a "$out/segments.txt"; }

rm -rf "$out" 2>/dev/null || S rm -rf "$out"
mkdir -p "$out"
before=$(snap)
cleanup() {
	S pkill -INT -x trossd 2>/dev/null || true
	S pkill -INT -x labmeasure 2>/dev/null || true
	S pkill -INT -f '^[^ ]*/labsrv life' 2>/dev/null || true
	S pkill -INT -f '^[^ ]*/labsrv wsclient' 2>/dev/null || true
	[ -f /run/tross-dhcp-soak/dnsmasq.pid ] && S kill "$(cat /run/tross-dhcp-soak/dnsmasq.pid)" 2>/dev/null || true
	sleep 2
	S "$lab" down >/dev/null 2>&1 || true
}
trap cleanup EXIT

S "$lab" down >/dev/null 2>&1 || true
S "$lab" up >/dev/null
S "$lab" offload off >/dev/null
S "$lab" shape isp1 8 1 0 500 500 >/dev/null
cfg=${SOAK_CONFIG:-configs/lab.yaml}
if [ "$cfg" = cake ]; then
	cfg=$out/lab-cake.yaml
	scripts/lab-cake-config >"$cfg"
fi
if [ "${SOAK_DNS:-}" = 1 ]; then
	awk '
		/^  upstreams:/ { print "  upstreams: [{ name: hash, url: \"https://203.0.113.54/dns-query\", pools: [protected, fast] }]"; next }
		/^  ca_file:/ { print "  ca_file: /run/tross-lab/dns-ca.pem"; next }
		{ print }
	' "$cfg" >"$out/lab-dns.yaml"
	cfg=$out/lab-dns.yaml
fi
if [ "${SOAK_HOME:-}" = 1 ]; then
	S rm -rf /run/tross-dhcp-soak
	awk '
		/^lan:/ { inlan = 1 }
		inlan && /^  networks:/ { print; print "  dhcp: { enabled: true, range: 192.168.77.100-192.168.77.250, lease: 10m, gateway: 192.168.77.1, dir: /run/tross-dhcp-soak, pid_file: /run/tross-dhcp-soak/dnsmasq.pid, unit: none }"; inlan = 0; next }
		{ print }
		END { print "upnp: { enabled: true }" }
	' "$cfg" >"$out/lab-home.yaml"
	cfg=$out/lab-home.yaml
fi
mkdir -p "$out/data"
printf '%s\n' "$pw" | tross "$bin/trossd" passwd -config "$cfg" -data-dir "$out/data" >/dev/null
# start_daemon [any] — запуск и ожидание: isp1 поднят; any — лишь бы API
# ответил (при хаосе каналов isp1 может быть оборван как раз сейчас).
start_daemon() {
	local want='"id":"isp1"[^}]*"state":"up"'
	[ "${1:-}" = any ] && want='"links"'
	tross "$bin/trossd" -config "$cfg" -data-dir "$out/data" >>"$out/trossd.log" 2>&1 &
	for _ in $(seq 1 300); do
		{ [ -s "$out/csrf" ] || login; } && apiget links | grep -q "$want" && return 0
		sleep 0.2
	done
	return 1
}
start_daemon || log "daemon did not bring isp1 up"
S "$bin/labmeasure" -out "$out/measure" -interval 10s -duration "$((deadline - $(now)))s" -proc trossd -netns tl-tross >/dev/null &

# Снимок метрик раз в 5 минут — фоном до конца прогона.
(while [ "$(now)" -lt "$deadline" ]; do
	m=$(apiget metrics || echo '{}')
	ct=$(tross cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null || echo 0)
	db=$(S du -sb "$out/data" 2>/dev/null | cut -f1)
	l=$(apiget links || echo '{}')
	nd=$({ apiget devices || true; } | { grep -o '"id":"dev-' || true; } | wc -l)
	nm=$({ apiget upnp || true; } | { grep -o '"ext_port":' || true; } | wc -l)
	echo "{\"t\":\"$(date -Is)\",\"conntrack\":$ct,\"data_dir_bytes\":${db:-0},\"devices\":$nd,\"upnp_mappings\":$nm,\"metrics\":$m,\"links\":$l}" >>"$out/metrics.jsonl"
	sleep 300
done) 9>&- &

chaos() { echo "$(date +%T) $*" >>"$out/chaos.txt"; }

# «Сутки провайдера»: вечером проводные проседают, ночью возвращаются; LTE
# плавает всегда. Профили — как у lab-netns (задержка, джиттер, потери).
if [ "${SOAK_PROVIDER:-}" = 1 ]; then
	(isp1=(500 350 250 350) isp2=(300 200 300 250) i=0
	while [ "$(now)" -lt "$deadline" ]; do
		a=${isp1[i % 4]} b=${isp2[i % 4]}
		S "$lab" shape isp1 8 1 0 "$a" "$a" >/dev/null
		S "$lab" shape isp2 12 2 0 "$b" "$b" >/dev/null
		chaos "provider: isp1 $a/$a, isp2 $b/$b Mbit/s"
		for _ in 1 2; do
			d=$((20 + RANDOM % 41)) u=$((5 + RANDOM % 16))
			S "$lab" shape lte 45 10 0.5 "$d" "$u" >/dev/null
			chaos "provider: lte $d/$u Mbit/s"
			sleep $((5 * unit))
		done
		i=$((i + 1))
	done) 9>&- &
fi

# Хаос каналов: обрыв (потери или нет линка) и возврат; restore берёт
# текущий профиль канала (его меняют «сутки провайдера»).
if [ "${SOAK_CHAOS:-}" = 1 ]; then
	(n=0
	while [ "$(now)" -lt "$deadline" ]; do
		sleep $(((3 + RANDOM % 6) * unit))
		n=$((n + 1))
		links=(isp1 isp2 lte)
		victims=("${links[RANDOM % 3]}")
		[ $((n % 5)) = 0 ] && victims=(isp1 isp2)
		mode=loss
		[ $((RANDOM % 2)) = 0 ] && mode=down
		hold=$((20 + RANDOM % 71))
		for v in "${victims[@]}"; do S "$lab" break "$v" "$mode" >/dev/null; done
		chaos "chaos: break ${victims[*]} ($mode) for ${hold}s"
		sleep "$hold"
		for v in "${victims[@]}"; do S "$lab" restore "$v" >/dev/null; done
		chaos "chaos: restore ${victims[*]}"
	done) 9>&- &
fi

# Хаос перезапусков: мягкая остановка и аварийное убийство по очереди;
# после убийства — trossd -cleanup, как ExecStopPost службы.
if [ -n "${SOAK_RESTARTS:-}" ]; then
	(n=0
	while [ "$(now)" -lt "$deadline" ]; do
		sleep $((SOAK_RESTARTS * unit))
		[ "$(now)" -lt "$((deadline - 60))" ] || break
		n=$((n + 1))
		t0=$(date +%s%N)
		if [ $((n % 2)) = 1 ]; then
			S pkill -INT -x trossd || true
			while pgrep -x trossd >/dev/null; do sleep 0.2; done
			how=stop
		else
			S pkill -KILL -x trossd || true
			while pgrep -x trossd >/dev/null; do sleep 0.2; done
			tross "$bin/trossd" -config "$cfg" -cleanup >>"$out/trossd.log" 2>&1 || true
			how=kill
		fi
		if start_daemon any; then
			chaos "restart ($how): daemon answers again in $((($(date +%s%N) - t0) / 1000000)) ms"
		else
			chaos "restart ($how): DAEMON DID NOT COME BACK"
		fi
	done) 9>&- &
fi

if [ "${SOAK_DNS:-}" = 1 ]; then
	(while [ "$(now)" -lt "$((deadline - 330))" ]; do
		for m in "miss load.example" "sets googlevideo.com" "hit load.example"; do
			[ "$(now)" -lt "$((deadline - 330))" ] || break
			# shellcheck disable=SC2086
			set -- $m
			echo "$(date +%T) $(client "$bin/labsrv" dnsload -names "$1" -suffix "$2" -qps 50 -duration 300s 2>&1)" >>"$out/dns.txt"
		done
	done) 9>&- &
fi

if [ "${SOAK_LIFE:-}" = 1 ]; then
	for a in 11 12 13; do client ip addr add "192.168.77.$a/24" dev eth0; done
	(client "$bin/labsrv" life -duration "$((deadline - $(now)))s" -out "$out/life.jsonl" \
		>>"$out/life.log" 2>&1 || true) 9>&- &
fi

if [ "${SOAK_HOME:-}" = 1 ]; then
	# Раздача адресов — dnsmasq по конфигу демона (как служба tross-dhcp).
	for _ in $(seq 1 50); do [ -f /run/tross-dhcp-soak/dnsmasq.conf ] && break; sleep 0.2; done
	tross dnsmasq --conf-file=/run/tross-dhcp-soak/dnsmasq.conf || log "dnsmasq did not start"
	home() { echo "$(date +%T) $*" >>"$out/home.txt"; }
	# Клиент стенда — доверенный для UPnP.
	client ping -c2 -W1 -i0.3 192.168.77.1 >/dev/null 2>&1 || true
	id=dev-$(client cat /sys/class/net/eth0/address | tr -d ':')
	for _ in $(seq 1 30); do apiget "devices/$id" | grep -q '"id"' && break; sleep 1; done
	apisend PATCH "devices/$id" '{"upnp":"allow"}' >/dev/null || home "upnp allow failed"
	# Две «вкладки» интерфейса — поток событий с переподключением.
	tok=$(S awk '$6 == "tross_session" { print $7 }' "$out/cookies" | tail -1)
	for _ in 1 2; do
		(client "$bin/labsrv" wsclient -url wss://192.168.77.1:8080/api/ws -origin https://192.168.77.1:8080 \
			-cookie "$tok" -duration "$((deadline - $(now)))s" -reconnect 10m >>"$out/ws.txt" 2>&1 || true) 9>&- &
	done
	# Погонщик: раз в 20–60 с — одно действие «дома».
	(n=0; while [ "$(now)" -lt "$((deadline - 60))" ]; do
		sleep $((20 + RANDOM % 41))
		n=$((n + 1))
		i=$((RANDOM % 40))
		mac=$(printf 'a6:00:00:00:%02x:%02x' $((i / 256)) $((i % 256)))
		case $((RANDOM % 10)) in
		0 | 1 | 2) home "dhcp $mac: $(client "$bin/labsrv" dhcpc -mac "$mac" -hostname "home-$i" 2>&1)" ;;
		3) # Телефон сменил случайный MAC: то же имя, новый адрес.
			nm=$(printf 'da:%02x:%02x:%02x:%02x:%02x' $((RANDOM % 256)) $((RANDOM % 256)) $((RANDOM % 256)) $((RANDOM % 256)) $((RANDOM % 256)))
			home "mac change home-$i -> $nm: $(client "$bin/labsrv" dhcpc -mac "$nm" -hostname "home-$i" 2>&1)" ;;
		4 | 5) port=$((46000 + RANDOM % 50))
			home "natpmp udp $port: $(client "$bin/labsrv" upnpc -natpmp -gw 192.168.77.1 -proto udp -port "$port" -lease 300 2>&1)" ;;
		6) port=$((45000 + RANDOM % 30))
			home "igd tcp $port: $(client "$bin/labsrv" upnpc -igd -proto tcp -port "$port" -lease 0 -desc TorrentClient 2>&1)" ;;
		7) port=$((45000 + RANDOM % 30))
			home "igd delete tcp $port: $(client "$bin/labsrv" upnpc -igd -proto tcp -port "$port" -delete 2>&1)" ;;
		8) for p in devices upnp dhcp links events; do apiget "$p" >/dev/null || home "api $p failed"; done ;;
		9) login && home "login ok" || home "login failed" ;;
		esac
	done) 9>&- &
fi

log "soak start, until $(date -d @"$deadline" +%T)"
while [ "$(now)" -lt "$deadline" ]; do
	for seg in "${SEGMENTS[@]}"; do
		read -r name minutes args <<<"$seg"
		left=$((deadline - $(now)))
		[ "$left" -gt 30 ] || break
		dur=$((minutes * unit < left ? minutes * unit : left))
		pids=()
		if [ "$args" != - ]; then
			# shellcheck disable=SC2086
			client "$bin/labsrv" load -url "$srv" $args -duration "${dur}s" >"$out/load.tmp" 2>&1 &
			pids+=($!)
		fi
		game=""
		if [ "$name" != idle ]; then
			client "$bin/labsrv" udpping -target 203.0.113.10:9000 -rate 64 -n $(((dur - 6) * 64)) -size 120 >"$out/game.tmp" 2>&1 &
			pids+=($!)
		else
			sleep "$dur" &
			pids+=($!)
		fi
		wait "${pids[@]}" || true
		[ "$name" != idle ] && game=$(tail -1 "$out/game.tmp")
		[ "$args" != - ] && load=$(tail -1 "$out/load.tmp") || load=""
		log "$name ${dur}s | $load | $game"
	done
done
log "soak end"

for p in metrics "system/stats?res=hour" "system/stats?res=minute&from=$(date -u -d '-6 days' +%FT%TZ)" \
	"links/isp1/stats?res=hour" "events?limit=1000" "logs?level=warn" devices upnp dhcp; do
	apiget "$p" >"$out/api-$(echo "$p" | cut -d'&' -f1 | tr '/?=&' '____').json" || true
done
cleanup
trap - EXIT
S ls -l "$out/data" >"$out/data-dir.txt"
S chown -R "$(id -u):$(id -g)" "$out" 2>/dev/null || true
after=$(snap)
[ "$before" = "$after" ] || log "HOST NETWORK CHANGED: $before -> $after"
log "SOAK DONE: $out"
